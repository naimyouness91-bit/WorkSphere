# Copy to docker/.env before: docker compose --env-file .env up -d --build

# --- Application ---
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Database (MySQL service) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=worksphere
MYSQL_USER=worksphere
MYSQL_PASSWORD=change-me-db
MYSQL_PORT=3306

# --- API / Auth ---
JWT_SECRET=change-me-jwt-secret-min-32-chars
AUTH_GUARD=api
APP_LOCALE=en
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Ports ---
API_PORT=8000
FRONTEND_PORT=3000

# --- Frontend build (baked into image at build time) ---
VITE_API_URL=http://localhost:8000/api
VITE_DEFAULT_LOCALE=en
