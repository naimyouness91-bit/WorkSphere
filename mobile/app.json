{
  "expo": {
    "name": "WorkSphere",
    "slug": "worksphere-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1628"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.worksphere.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to sign in to WorkSphere quickly and securely."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1628"
      },
      "package": "com.worksphere.mobile",
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1e3a8a"
        }
      ],
      "expo-local-authentication"
    ],
    "scheme": "worksphere",
    "extra": {
      "apiUrl": "http://127.0.0.1:8765/api"
    }
  }
}
