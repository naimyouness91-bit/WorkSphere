# App environment: development | staging | production
VITE_APP_ENV=development
VITE_APP_VERSION=0.0.0

# Dev (recommended): proxy through Vite — run scripts/start-backend.ps1 first
VITE_API_URL=/api
VITE_API_BASE_URL=
VITE_DEV_API_PROXY=http://127.0.0.1:8765

# Production / direct API (uncomment and set your API host)
# VITE_API_URL=https://api.example.com/api
# VITE_API_BASE_URL=https://api.example.com

# Pusher (or Soketi — Pusher-compatible local server)
VITE_PUSHER_APP_KEY=worksphere-key
VITE_PUSHER_APP_CLUSTER=mt1
# For Soketi / local WebSocket server:
# VITE_PUSHER_HOST=127.0.0.1
# VITE_PUSHER_PORT=6001
# VITE_PUSHER_SCHEME=http

# Error tracking (optional)
# VITE_SENTRY_DSN=
